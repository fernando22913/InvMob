# Backend configuration. Copy to .env and adjust.

PORT=8000

# Database connection components (db runs in Docker, mapped to host port 5433).
DB_HOST=localhost
DB_PORT=5433
DB_NAME=inventario_generico
DB_USER=postgres
DB_PASSWORD=postgres

# Optional full URL override (takes precedence over the components above).
DATABASE_URL=

# Security - required, the API refuses to start with an empty/placeholder value.
# Generate one with: openssl rand -base64 48
SECRET_KEY=

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Initial admin (used by the idempotent seed script). Leave empty to skip
# creating the admin; if set, the seed provisions it on first run. Never commit
# real credentials.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=Administrator

# CORS (comma-separated, or a JSON array).
CORS_ORIGINS=http://localhost,http://localhost:4200,http://localhost:8100,http://localhost:8000,capacitor://localhost,https://localhost

DEBUG=false
